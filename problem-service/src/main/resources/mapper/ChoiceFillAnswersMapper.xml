<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anishan.problem.mapper.ChoiceFillAnswersMapper">

    <resultMap id="BaseResultMap" type="com.anishan.problem.domain.entity.ChoiceFillAnswers">
            <id property="answerId" column="answer_id" jdbcType="BIGINT"/>
            <result property="problemId" column="problem_id" jdbcType="BIGINT"/>
            <result property="answerText" column="answer_text" jdbcType="VARCHAR"/>
            <result property="isCorrect" column="is_correct" jdbcType="TINYINT"/>
            <result property="blankIndex" column="blank_index" jdbcType="INTEGER"/>
            <result property="score" column="score" jdbcType="DECIMAL"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectByProblemIdForUpdate" resultMap="BaseResultMap">
        select answer_id, problem_id, answer_text, is_correct, blank_index, score,
               del_flag, create_time, update_time
        from choice_fill_answers
        where problem_id = #{problemId} and del_flag = 0
        order by answer_id asc
        for update
    </select>

</mapper>
