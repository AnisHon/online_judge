<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anishan.problem.mapper.ContestMapper">

    <resultMap id="BaseResultMap" type="com.anishan.problem.domain.entity.Contest">
            <id property="contestId" column="contest_id" jdbcType="BIGINT"/>
            <result property="userId" column="user_id" jdbcType="BIGINT"/>
            <result property="title" column="title" jdbcType="VARCHAR"/>
            <result property="listId" column="list_id" jdbcType="BIGINT"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="auth" column="auth" javaType="com.anishan.commons.enumeration.ContestAuth" jdbcType="INTEGER"
                    typeHandler="com.baomidou.mybatisplus.core.handlers.MybatisEnumTypeHandler"/>
            <result property="type" column="type" javaType="com.anishan.commons.enumeration.ContestType" jdbcType="INTEGER"
                    typeHandler="com.baomidou.mybatisplus.core.handlers.MybatisEnumTypeHandler"/>
            <result property="pwd" column="pwd" jdbcType="VARCHAR"/>
            <result property="startTime" column="start_time" jdbcType="TIMESTAMP"/>
            <result property="endTime" column="end_time" jdbcType="TIMESTAMP"/>
            <result property="submitted" column="submitted" jdbcType="TINYINT"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="scoringVersion" column="scoring_version" jdbcType="INTEGER"/>
            <result property="nextAttemptSeq" column="next_attempt_seq" jdbcType="BIGINT"/>
            <result property="problemSnapshotAt" column="problem_snapshot_at" jdbcType="TIMESTAMP"/>
    </resultMap>
    <delete id="deleteBatchUserContestRelations">
        delete from user_contest
        where (user_id, contest_id) in 
        <foreach collection="relations" item="relation" open="(" separator="," close=")" >
            (#{relation.userId}, #{relation.contestId})
        </foreach>
    </delete>

    <select id="selectContestForUpdate" resultMap="BaseResultMap">
        SELECT contest_id, user_id, title, list_id, description, auth, type, pwd,
               start_time, end_time, submitted, del_flag, create_time, update_time,
               scoring_version, next_attempt_seq, problem_snapshot_at
        FROM contest
        WHERE contest_id = #{contestId} AND del_flag = 0
        FOR UPDATE
    </select>

    <update id="setProblemSnapshotAt">
        UPDATE contest
        SET problem_snapshot_at = #{snapshotAt},
            update_time = GREATEST(CURRENT_TIMESTAMP, DATE_ADD(update_time, INTERVAL 1 SECOND))
        WHERE contest_id = #{contestId} AND del_flag = 0 AND problem_snapshot_at IS NULL
    </update>

    <update id="resetProblemSnapshot">
        UPDATE contest
        SET list_id = #{listId}, problem_snapshot_at = #{snapshotAt},
            update_time = GREATEST(CURRENT_TIMESTAMP, DATE_ADD(update_time, INTERVAL 1 SECOND))
        WHERE contest_id = #{contestId} AND del_flag = 0
    </update>

    <update id="updateNextAttemptSeq">
        UPDATE contest
        SET next_attempt_seq = #{nextSeq}
        WHERE contest_id = #{contestId} AND del_flag = 0
          AND COALESCE(next_attempt_seq, 0) = #{expectedSeq}
    </update>


</mapper>
