<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anishan.problem.mapper.UserSubmitMapper">

    <resultMap id="BaseResultMap" type="com.anishan.problem.domain.entity.UserSubmit">
            <result property="userId" column="user_id" jdbcType="BIGINT"/>
            <result property="contestId" column="contest_id" jdbcType="BIGINT"/>
            <result property="submitTime" column="submit_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insertIgnore">
        INSERT IGNORE INTO user_submit(user_id, contest_id, submit_time)
        VALUES (#{userId}, #{contestId}, #{submitTime})
    </insert>

    <delete id="deleteByContestAndUser">
        DELETE FROM user_submit WHERE contest_id = #{contestId} AND user_id = #{userId}
    </delete>

</mapper>
