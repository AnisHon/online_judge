<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anishan.problem.mapper.UserContestMapper">

    <insert id="insertBatchIgnore">
        INSERT IGNORE INTO user_contest(user_id, contest_id) VALUES
        <foreach collection="relations" item="relation" separator=",">
            (#{relation.userId}, #{relation.contestId})
        </foreach>
    </insert>

    <delete id="deleteByContestAndUsers">
        DELETE FROM user_contest
        WHERE contest_id = #{contestId}
          AND user_id IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>

</mapper>
