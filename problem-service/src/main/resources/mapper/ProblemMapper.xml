<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anishan.problem.mapper.ProblemMapper">

    <resultMap id="BaseResultMap" type="com.anishan.problem.domain.entity.Problem">
            <id property="problemId" column="problem_id" jdbcType="BIGINT"/>
            <result property="title" column="title" jdbcType="VARCHAR"/>
            <result property="type" column="type" jdbcType="INTEGER"/>
            <result property="source" column="source" jdbcType="VARCHAR"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="hint" column="hint" jdbcType="VARCHAR"/>
            <result property="auth" column="auth" jdbcType="INTEGER"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        problem_id,title,type_id,
        source,description,hint,
        auth,del_flag,create_time,
        update_time
    </sql>
<!--    List<Problem> selectAllByProblemIdAndTagId(Wrapper<Problem> wrapper);-->
    <select id="selectAllByProblemIdAndTagId" resultType="com.anishan.problem.domain.entity.Problem">
        select
            p.problem_id as problem_id,
            oj_id, title, type, source, description, hint, auth, del_flag, create_time, update_time
        from problem p
        left join problem_tag tag on tag.problem_id = p.problem_id
        where p.auth = 1

        <if test="problemId != null">
            and p.problem_id = #{problemId}
        </if>
        <if test="tagIds != null and tagIds.size > 0 ">
            and tag.tagId in
            <foreach collection="tagIds" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>


    </select>
</mapper>
