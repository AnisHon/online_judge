<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anishan.user.mapper.SysUserMapper">

    <resultMap id="BaseResultMap" type="com.anishan.api.domain.entity.SysUser">
            <id property="userId" column="user_id" jdbcType="BIGINT"/>
            <result property="userName" column="user_name" jdbcType="VARCHAR"/>
            <result property="email" column="email" jdbcType="VARCHAR"/>
            <result property="nikeName" column="nike_name" jdbcType="VARCHAR"/>
            <result property="password" column="password" jdbcType="VARCHAR"/>
            <result property="status" column="status" jdbcType="TINYINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="delFlag" column="del_flag" jdbcType="TINYINT"/>
            <result property="remark" column="remark" jdbcType="VARCHAR"/>
    </resultMap>


<!--    List<SysUser> selectByTeacherIdLimit(Long teacherId,  Long currentPage, Long pageSize);-->

    <select id="selectByTeacherIdLimit" resultType="com.anishan.api.domain.entity.SysUser">
        select distinct
            user_id,
            user_name,
            email,
            nike_name,
            status,
            create_time,
            remark
        from sys_user
        right join student_class sc on sc.student_id = sys_user.user_id
        left join teacher_class tc on sc.class_id = tc.class_id

        where
            teacher_id = #{teacherId}
        and
            del_flag = 0
        limit #{currentPage}, #{pageSize}

    </select>





    <select id="selectUserByUserRoleQuery" resultType="com.anishan.api.client.user.domain.vo.UserVo" >

        select distinct
            su.user_id as user_id,
            user_name,
            email,
            nike_name,
            su.status as status,
            su.create_time as create_time,
            remark
        from sys_user su
            right join sys_user_role sur on sur.user_id = su.user_id

        where
            del_flag = 0
        and
            role_id = #{userQuery.roleId}
        <if test="userQuery.username != null and userQuery.username.length > 0">
            and user_name like concat(#{userQuery.username}, '%')
        </if>
        <if test="userQuery.email != null and userQuery.email.length > 0">
            and email like concat(#{userQuery.email}, '%')
        </if>
        <if test="userQuery.nikeName != null and userQuery.nikeName.length > 0">
            and nike_name like concat(#{userQuery.nikeName}, '%')
        </if>
    </select>

</mapper>
