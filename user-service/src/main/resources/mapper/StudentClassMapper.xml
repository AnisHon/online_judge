<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anishan.user.mapper.StudentClassMapper">

    <resultMap id="BaseResultMap" type="com.anishan.user.domain.entity.StudentClassRelation">
            <id property="studentId" column="student_id" jdbcType="BIGINT"/>
            <id property="classId" column="class_id" jdbcType="BIGINT"/>
    </resultMap>

    <insert id="insertIgnore">
        <foreach collection="relations" item="relation" separator=";">
            insert ignore into student_class(class_id, student_id) values (#{relation.classId}, #{relation.studentId})
        </foreach>
    </insert>
</mapper>
