<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anishan.content.mapper.FileInfoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.anishan.content.domain.entity.FileInfo">
        <id column="file_id" property="fileId" />
        <result column="file_name" property="fileName" />
        <result column="file_path" property="filePath" />
        <result column="file_size" property="fileSize" />
        <result column="upload_time" property="uploadTime" />
    </resultMap>

    <select id="selectByFileMd5AndFileSizeAndFileType" resultType="com.anishan.content.domain.entity.FileInfo">
        select
            file_id,
            file_name,
            file_path,
        from file_info
        where 
            (file_md5, file_size, file_type) in 
        <foreach collection="fileInfos" item="item" separator="," open="(" close=")">
            (#{item.fileMd5}, #{item.fileSize}, #{item.fileType})
        </foreach>
    </select>

</mapper>
